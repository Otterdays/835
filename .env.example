# Copy to .env and fill before deploying (never commit .env)
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/oe835?retryWrites=true&w=majority
MONGODB_DB=oe835
AUTH_SECRET=generate-a-long-random-string
SESSION_TTL_HOURS=12
# Set to "1" only for local static serve without Mongo (not for production)
AUTH_LOCAL_FALLBACK=0

# Optional account creation controls (blank code = open signup; closed=1 disables registration)
SIGNUP_CODE=
SIGNUP_CLOSED=0

# Admin AI assistant (server-only; never expose in browser code).
# Free-only OpenRouter key: https://openrouter.ai/keys. Leave blank to disable the panel.
OPENROUTER_API_KEY=
# 0 = only free models with verified zero-data-retention endpoints are offered.
# 1 = also offer other free models; each use requires an explicit privacy confirmation.
LLM_ALLOW_NON_ZDR=1
